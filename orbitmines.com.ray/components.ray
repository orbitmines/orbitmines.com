Features := class {
  static ether = true
  static physics = false
}

// Windows downloads the installer; Linux and macOS show the install command on hover and copy it on click; phones and tablets show nothing (Ether.tsx).
INSTALL = "curl -fsSL https://ether.orbitmines.com/install.sh | bash"
WINDOWS_EXECUTABLE = @https://github.com/orbitmines/ray/releases/latest/download/ether-x86_64-pc-windows-msvc.exe
ETHER = @../orbitmines.com/public/Ether.svg

Button := class {
  icon: String?
  text: *?
  right_icon: String?
  icon_color: Color?
  icon_size: Length = 16px
  outlined: boolean = false
  small: boolean = false

  middle center {height >= (small ? 24px : 30px) & width >= (small ? 24px : 30px)} .map(,) <- (
    Icon(icon, color: icon_color, size: icon_size) ^icon if icon,
    text if text,
    Icon(right_icon) ^icon if right_icon
  ) ^button ^minimal ^{small ? "small_button" : "none"} ^{outlined ? "outlined" : "none"} ^{pressed ? "pressed" : hovered ? "hovered" : "none"}
}

DownloadButton := class {
  os = (@me/device/os/name){windows | macos | linux} unless @me/device/handheld
  shown => os.match
    windows => "Windows"
    macos => "MacOS"
    linux => "Linux"
  label (verb: String) => middle .map(,) <- (verb, ETHER{width <= 100% & height <= 50px} ~~ .alt = "Ether's Almanac", "for " + shown if UI.scene.size.x > 575px)

  copied_at: Time?
  copied => copied_at && now - copied_at < 1.2 s
  activate => os == windows ? (UI.at = WINDOWS_EXECUTABLE) : (@me/device/clipboard = INSTALL) -- (copied_at = now)

  (os == windows
    ? Button(icon: "download", text: label("Download"))
    : Button(icon: hovered ? (copied ? "tick" : "duplicate") : "console", text: {height >= 50px} middle (hovered ? ("$ " + INSTALL) ^code ^nowrap : label("Install")))
  ){font.size == 18px} ^underline if Features.ether && os
}

LoginButton := class {
  Button(icon: "link", icon_color: "#EAB832" as Color, icon_size: 20px, outlined: true)
}

// Blueprint's icons, as the site uses them, kept in the repository; a terminal shows the glyph instead.
Icon := class (name: String, color: Color?, size: Length = 16px) => {
  @../orbitmines.com/public/icons/blueprint/ (size >= 20px ? "20px" : "16px") / name .svg{height == size, fill == color ?? currentColor}
  glyph => { "download": "⤓", "console": ">_", "duplicate": "⧉", "tick": "✓", "link": "🔗", "arrow-left": "←", "arrow-right": "→", "media": "▣", "document": "▤", "search": "⌕", "shorten-text": "≡", "lengthen-text": "☰" }[name] ?? "•"
}

TagLink := class {
  to: Location
  icon: Organization
  name: *?
  intent: String?

  middle {height >= 20px} .map(,) <- (icon.icon(color: intent ? UI.Theme[intent + "_tag"].color : None, size: 20px), px 5 (name ?? (to as String).replace("https://", "")){font.size == 1.1rem})
    ^tag ^{intent ? intent + "_tag" : "none"} ^{hovered ? (intent ? intent + "_tag_hovered" : "tag_hovered") : "none"} @ to{window == new}
}

Author := class {
  character: Character

  center middle .map(&+ px 2) .map(,) <- {
    character.profile_picture{width <= 32px} ~~ .alt = "Profile picture" ^circle
    {
      character.name ^h3 @ character.profile.location
      start "@" + character.profile.name ^muted ^small @ character.profile.location
    }
  }
  center character.email ^h4 @ character.email{window == new}
  center .map(&+ px 2) .map(,) <- character.avatars{Platforms.shown.contains(.platform)}.map(.platform.icon(size: 16px) @ .location{window == new})
}

Affiliation := class {
  organization: Organization

  center middle .map(&+ px 2) .map(,) <- {
    organization.logo{width <= 150px} ~~ .alt = organization.name
    start "@" + organization.handle ^muted ^small @ "/@" + organization.handle
  }
  center .map(&+ px 2) .map(,) <- organization.avatars.map(.platform.icon(size: 16px) @ .location{window == new})
}

Label := class {
  text: String
  text ^label ^disabled
}

Booklet := class {
  image: Location{language === Language.Image}
  alt: String
  reference: Reference
  disabled: boolean = false

  shown => (disabled ? reference ~~ (.title = (reference.title, " (coming soon)" ^disabled)) ~~ (.location = None) : reference) ~~ (.window = same)

  middle .map(,) <- {
    {width == 3/12} image{width == 100% & height <= 100px} ~~ (.fit = contain) ~~ (.alt = alt)
    {width == 9/12} start shown~card
  } ^{disabled ? "faded" : "none"}
}

Repository := class {
  path: String
  about: String
  Reference(title: (path, " ", about ^muted), organizations: @github, location: @https://github.com/orbitmines/ path[1..])~card
}

OrgIcon := (organization: Organization?) => (organization.profile_picture ?? organization.logo){width == 18px & height == 18px, margin.right == 6px} ~~ (.fit = contain) ~~ (.alt = organization.name) if organization?.profile_picture ?? organization?.logo

Timeline := class {
  heading: *
  title: String?
  leading: *?
  grouped: boolean = false
  compact: boolean = false
  below: *?
  entries: Entry[]

  static Entry := class {
    when: String
    what: *
    description: *?
    year => (when ~= (*, year: Decimal{length == 4}, *))?.year
    future => year && year > Time.now.year
  }

  small => UI.scene.size.x <= 640px
  ordered => grouped ? entries.sort_by(-(.year ?? 0)) : entries
  repeated (entry) => grouped && entry.year && entry.index > 0 && ordered[entry.index - 1].year == entry.year
  label (entry) => grouped ? (entry.year as String ?? entry.when) : entry.when
  specific (entry) => grouped && entry.year && entry.when.trimmed != entry.year as String
  detail (entry) => ((mr (entry.description ? 4 : 0) (entry.when, "." if entry.description)) if specific(entry), entry.description) ^muted {font.size == (compact ? 0.7rem : 0.9rem)} if entry.description || specific(entry)

  start py 12 {
    middle mb 8 {gap == Vector(24px, 24px)} .map(,) <- {
      {width == 96px} middle center leading if leading
      {
        heading ^large {color == "#e6e6e6" as Color}
        title ^muted {font.size == 0.95rem} if title
      }
    }
    mb 6 below if below
    pl (small ? 0 : 11) layered {
      {position.kind == absolute, inset.left == 6px, inset.top == 6px, inset.bottom == 6px, width == 2px} "" {fill == "#ffffff2e" as Color} unless small
      ordered.map(entry => py (compact ? 1.5 : 4) {color == (entry.future ? "#ffffff66" : "#e6e6e6") as Color} layered {
        {position.kind == absolute, inset.left == -22px, inset.top == (compact ? 7px : 14px), width == 14px, height == 14px} "" ^circle
          {fill == (entry.future ? "#5c6370" : "#abb3bf") as Color, stroke == Stroke("#0a0a0a" as Color, width: 2px)} unless repeated(entry) || small
        small ? {
          label(entry) ^{entry.future ? "disabled" : "marker"} unless repeated(entry)
          (entry.what ^{entry.future ? "muted" : "none"} {font.size == (compact ? 0.8rem : 1em)}, ml 4 detail(entry))
        } : .map(,) <- {
          {width == 90px} mr 6 (repeated(entry) ? "" : label(entry)) ^{entry.future ? "disabled" : "marker"}
          {
            entry.what ^{entry.future ? "muted" : "none"} {font.size == (compact ? 0.8rem : 1em)}
            mt 1 detail(entry)
          }
        }
      })
    }
  }
}

// The filter is a chosen string: the library renders it as a text field in the browser and in the terminal;
// what the user types, and whether it is focused, are variables the page reads (F-D6).
LiteraryExposure := class {
  by_year: (year: Number, references: Reference[])[]
  query: Choice = Choice(type: String, value: "", placeholder: "filter — try: type:video  person:\"Isaac Asimov\"  org:youtube  after:2024")
  cursor: Number = 0
  unfiltered_height: Length?

  items => by_year.map(pair => pair.references.map((pair.year, .))).flatten
  filters => Query(query)
  filtered => items{filters.admits(.1, .0)}

  authors => items.1.authors.name.flatten.unique.sort
  organizations => items.1.organizations.flatten.unique.sort_by(.key)
  years => items.0.unique.sort.reverse

  typed => (query ~= (*, " "?, last: (!" ")[]) ⊣).last ?? ""
  suggestions => typed.lowercase ~= (key: *, ":", value: *)
    ? .key.match
      "type" => ["book", "article", "video"]{.starts_with(.value)}.map(("type:" + ., "type:" + .))
      "person" => authors{.lowercase.contains(.value)}.take(8).map(("person:\"" + . + "\"", "person: " + .))
      "organization" | "org" => organizations{.key.lowercase.contains(.value) || .name.lowercase.contains(.value)}.take(8).map((.key + ":" + ⊢.key, .key + ": " + ⊢.name))
      "after" | "before" | "since" | "year" => years{. as String ~= ⊢.value}.take(12).map((.key + ":" + ., .key + ":" + .))
      * => []
    : Query.keys{.starts_with(typed.lowercase)}.map((. + ":", . + ":"))
  completion => suggestions[cursor]?.0 ~~ (.lowercase.starts_with(typed.lowercase) ? .[typed.length..] : "") ?? ""
  insert (suggestion) => query.value = (query.value ~= (before: *, (!" ")[] ⊣)).before ~~ (. + (" " if .nonempty && !.ends_with(" "))) + suggestion.0 + " "

  with (cursor = 0) when query.value changes,
    (unfiltered_height = this.size.y) if query.value.empty && !unfiltered_height,
    insert(suggestions[cursor]) if UI.focus.some(.content === query) && @me/device/keyboard/Tab.pulsed && suggestions.nonempty {
    {height >= unfiltered_height} Timeline("Literary Exposure",
      grouped: true,
      compact: true,
      below: {width <= 720px} mb 4 {
        layered {
          query ^code {font.size == 0.9rem, padding == Edges(8px, 12px, 8px, 12px), fill == None, stroke == Stroke("#ffffff1f" as Color), radius == [4px], color == "#e6e6e6" as Color, layer == 1}
          {padding == Edges(8px, 12px, 8px, 12px), font.size == 0.9rem, white_space == WhiteSpace.pre, overflow == clip} (query.value {visible == false}, completion {color == "#ffffff40" as Color}) if completion
        }
        {height >= 22px} mt 2 {font.size == 0.8rem, gap == Vector(6px, 6px)} inline wrap .map(,) <- (UI.focus.some(.content === query) && suggestions.nonempty
          ? suggestions.map((suggestion, i) => px 1 suggestion.1 ^{i == cursor ? "none" : "disabled"} {color == ("#ffffff99" as Color if i == cursor)} ~~ activate => insert(suggestion))
          : [(filtered.count, " of ", items.count) ^disabled])
      },
      entries: filtered.map((year, item) => Timeline.Entry(
        year as String,
        (item.organizations.map(OrgIcon(.)), item.title) @ item.location{window == new},
        description: item.named_authors.nonempty ? (item.named_authors, (" " + (item.year as String)) if item.year, (". ", item.description) if item.description) : item.description
      ))
    )
  }

  static Query := class (text: String) => {
    static keys = ["type", "person", "organization", "org", "after", "before", "since", "year"]

    tokens => text ~= ((Letter[], ":", "\"", (!"\"")[], "\"") | (Letter[], ":", (!" ")[]) | ("\"", (!"\"")[], "\"") | (!" ")[])[]
    keyed => tokens{.contains(":") && keys.contains(.before(":").lowercase)}
    values (key: String) => keyed{.before(":").lowercase == key}.map(.after(":").trimmed("\"").lowercase)
    number (key: String) => values(key).last as Decimal
    words => tokens{!keyed.contains(.)}.map(.trimmed("\"").lowercase)

    kind (item: Reference) => item.kind ?? (item.organizations.some(.key == "youtube") ? Exposure.video : Exposure.article)

    admits (item: Reference, year: Number) => {
      names = item.authors.name.lowercase
      shown = ((item.title ==.instance_of String ? item.title.lowercase : ""), year, names).join(" ")
      (values("type").empty || values("type").contains(kind(item) as String))
        && values("person").every(person => names.some(.contains(person)))
        && (values("organization"), values("org")).every(org => item.organizations.some(.key.lowercase.contains(org) || .name.lowercase.contains(org)))
        && (values("year").empty || year == number("year"))
        && (values("after").empty || year > number("after"))
        && (values("before").empty || year < number("before"))
        && (values("since").empty || year >= number("since"))
        && words.every(shown.contains(.))
    }
  }
}

Gallery := class {
  images: Location{language === Language.Image}[] = children
  caption: *?
  height: Length = 450px
  shuffle: Number?

  static shuffled (items, seed: Number) => ((items.count - 1)..1).reduce(acc = (items, seed) => {
    next = acc.1 * 16807 % 2147483647
    (acc.0.swapped(., ((next - 1) / 2147483646 * (. + 1)).floor), next)
  }).0
  shown => shuffle ? shuffled(images, shuffle) : images

  at: Number = 0
  go (index: Number) => at = index max 0 min (shown.count - 1)
  wheeled_at: Time?
  scrolled => UI.pointer.wheel.y || UI.pointer.wheel.x
  drag: (from: Length, offset: Length, moved: boolean, velocity: Number)?
  dragged_offset: Length?
  phone => UI.scene.size.x <= 767px
  items => track.children.first.children
  centre_of (index: Number) => items[index].origin.x + items[index].size.x / 2 - track.size.x / 2
  nearest => shown.indices.min_by((centre_of(.) - (dragged_offset ?? centre_of(at))).abs)
  pulled => UI.pointer.position.x - drag.from

  with (drag = (from: UI.pointer.position.x, offset: centre_of(at), moved: false, velocity: 0)) if track.pressed && !drag && !(UI.focus.first is Button),
    (drag.moved = drag.moved || pulled.abs > 5px) -- (dragged_offset = drag.offset - pulled if drag.moved) -- (drag.velocity = UI.pointer.velocity.x) when UI.pointer.position changes if drag,
    (go(at + (scrolled > 0 ? 1 : -1)) -- (wheeled_at = now)) if track.hovered && scrolled.abs >= 5 && !(wheeled_at && now - wheeled_at < 350 ms),
    (drag.moved ? (drag.velocity.abs > 0.05 ? go(at + (drag.velocity < 0 ? 1 : -1)) : go(nearest)) -- (drag = None) -- (dragged_offset = None)) when UI.pointer.released becomes true if drag {
    {width == 100%} {
      center caption ^muted ^smaller if caption
      track = {overflow == clip, cursor == grab, touch == pan_y} {
        inline py 8 {gap == Vector(12px, 12px)} {transform == Transform.translate(Vector(-(dragged_offset ?? centre_of(at))))} {transition == (drag ? None : Transition(0.4 s, ease))} .map(,) <- shown.map((image, i) => {
          item = {radius == [6px], overflow == clip, transition == Transition(0.3 s, ease), transform == Transform.scale(i == at ? 1 : 0.85)} layered {
            image{aspect == 16/9, height == (phone ? None : height), width == (phone ? 85vw : None)} ~~ (.fit = cover) ~~ (.alt = image.alt ?? "")
            {position.kind == absolute, inset.top == 8px, inset.right == 8px} ((i + 1) as String, " / ", shown.count as String) ^nav_badge if i == at
            {position.kind == absolute, inset.top == 0px, inset.bottom == 0px, inset.left == 0px, width == 48px} "‹" ^nav ^{hovered ? "nav_hovered" : "none"} ~~ activate => go(at - 1) if i == at && at > 0 && item.hovered
            {position.kind == absolute, inset.top == 0px, inset.bottom == 0px, inset.right == 0px, width == 48px} "›" ^nav ^{hovered ? "nav_hovered" : "none"} ~~ activate => go(at + 1) if i == at && at < shown.count - 1 && item.hovered
          } + Filter(opacity, i == at ? 1 : 0.5) + (Shadow(Vector(0, 4px), blur: 24px, color: "#0000004d" as Color) if i == at)
            ~~ activate => go(i) unless drag?.moved
        })
      }
    }
  }
}

Visualization := class {
  alt: String
  framed: boolean = true
  height: Length = 30px

  {height == height, overflow == clip} middle center Article.current.images alt .png ^{framed ? "block" : "none"}
}

CodeBlock := class {
  code: String ^{language}
  palette: * = DRACULA
  editable: boolean = false
  wrapped: boolean = false

  text: Choice = Choice(type: String{multiline}, value: code, language: language)
  Geometry.Box(content: editable ? text : code.highlighted(language), palette: palette)
    ^block ^code {white_space == (wrapped ? WhiteSpace.pre_wrap : WhiteSpace.pre)} start
}
UI.Scene &+= {
  {code: String{language}} => Article.current?.code(code) ?? CodeBlock(code)
}

Scene := class {
  source: *
  source ^code
}

SectionButton := class {
  section: String
  text: String = section
  Button(text: text, right_icon: "arrow-right", outlined: true) ~~ activate => Article.current.go(Article.current.sections{.name == section}.first)
}

TODO := class {
  text: *
  start ("TODO: [", text, "]") ^muted
}

Thumbnail := class {
  title: String = UI.at.parameter("title") ?? "OrbitMines - Stream"
  subtitle: String = UI.at.parameter("subtitle") ?? ""
  date: String = UI.at.parameter("date") ?? (Time.now.date as String)
  width: Length = (UI.at.parameter("width") ?? "1920") as Decimal * 1px
  height: Length = (UI.at.parameter("height") ?? "1080") as Decimal * 1px

  {width == width, height == height, transform == Transform.scale(width / 1240px * 1.1)} middle center {
    pt 35 px (xs 0 -> lg 50) .map(&+ pb 15) <- {width <= 1240px} Header(Article(title: title, subtitle: subtitle, date: date, organizations: @orbitmines, authors: @fadi, draft: false)) ^article
    {height == 140px} middle center @../orbitmines.com/public/archive/on-orbits-equivalence-and-inconsistencies/images/header.png
  }
}

Organization &+= {
  icon (color: Color? = None, size: Length = 16px) => .profile_picture{height == size, fill == color ?? currentColor}
}

Location &+= {
  parameter (name: String) => query?.pairs{.name == name && (.value ?? "").nonempty}.last?.value
}
