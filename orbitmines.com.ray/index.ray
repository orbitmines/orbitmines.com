// What running the site does is the level in scope (F-A1, F-D2):
//   Program(code: { orbitmines.com }).rendered(UI.HTML.level).write(@./dist)    the static package: index.html, style.css, app.js, assets
//   Program(code: { orbitmines.com }).run(UI.HTML, UI.HTML.DOM())          the development runtime in the browser
//   Program(code: { orbitmines.com }).run(UI.TUI, UI.TUI.Target())         the same site, interactive in a terminal
(dynamically if @me/development?) orbitmines.com() if &entrypoint

orbitmines.com := class {
  profiles: Profile$ @ /@
  profile_redirects: (handle => UI.at = /@ + handle) @ /profiles/
  archive: Article$ @ /archive/
  paper_redirects: (rest => UI.at = /archive/ + rest) @ /papers/
  almanac: Almanac @ /almanac if Features.ether
  physics: physics @ /physics if Features.physics
  thumbnail: Thumbnail @ /thumbnail
  {*}: Index

  title: "OrbitMines Research"
  description: "Once a Minecraft server, now the building of a world where engineering, science, education are all an exploratory videogame."
  image: @https://orbitmines.com/logo.png
  icon: @../orbitmines.com/public/favicon.png
  meta: [(name: "og:site_name", content: "OrbitMines"), (name: "twitter:site", content: "@OrbitMines"), (name: "og:type", content: "website"), (name: "og:image", content: image as String), (name: "og:image:type", content: "image/jpeg"), (name: "theme-color", content: "#000000")]
  manifest: @../orbitmines.com/public/manifest.json
  apple_icon: @../orbitmines.com/public/logo192.png

  Index\
  {width == 100% & width <= 100vw & height >= 100vh} py (xs 12 -> md 0) middle center .map(100% * center * .) <- {
    center {width <= 1240px} {
      end middle .map(&+ px 5) <- DownloadButton
    }
    center @../orbitmines.com/public/organizations/orbitmines/logo/orbitmines.logo.3000x1000.png{width == 90% & width <= 400px, alt: "logo"}
    pt 5 center (xs 12/12 -> sm 10/12 -> md 8/12 -> lg 6/12 -> xl 4/12) center .description ^italic
    center py 2 px 2 .map(&+ pt 5 px 2) <- @orbitmines.avatars#{.platform is Platform.shown}.map(.platform.icon(size: 20px) @ .location{window == new})
    {width == 100% & height == 120px, overflow == clip} middle center @../orbitmines.com/public/archive/on-orbits-equivalence-and-inconsistencies/images/header.png
    middle center .map(,) <- {
      {width <= 500px} {
        "Booklets" ^label ^disabled
        Booklet(@../orbitmines.com/public/almanac/almanac.png{alt: "E"}, Almanac, disabled: !Features.ether)
        Booklet(@../orbitmines.com/public/2026-09-12_Sun.png{alt: "Physics Project"}, physics, disabled: !Features.physics)
      }
      {width <= 500px} {
        pb 4 .map(&+ mr 3) <- (@github.icon(size: 16px), "github.com/orbitmines") ^muted @ @https://github.com/orbitmines{window == new}
        pl 9 {
          Repository("/ray", "The Ray Programming Language & The Ether")
          Repository("/physics", "OrbitMines: Physics Project")
          Repository("/archive", "Public research archive")
          Repository("/orbitmines.com", "Website to the internet")
        }
      }
    }
    my 2.5rem @fadi as Author
    center {width <= 500px} {
      "/updates" ^label ^disabled
      pl 9 writings.map((. ~~ (.window = same))~entry)
    }
  }
}
