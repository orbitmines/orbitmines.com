orbitmines.com() if &entrypoint

// equivalent code (classes defined elsewhere)
orbitmines.com := {
  profiles: Profile$ // maps to /profiles/<id> through Location.url where superposed ones match to an identifier (doesnt have to be unique, result can be a superposition)
  archive: Article$ // maps to /archive/<id>
  almanac = Almanac
  {*}: Index
}

orbitmines.com := {
  Profile @ /profiles/ x: Profile$ {
  
  }
  Archive @ /archive/ x: Article$ {

  }
  Almanac @ /almanac {

  }

  Index @ / {
    articles: Article[] =
      "towards-a-universal-language",
      "2024-02-orbitmines-as-a-game-project",
      "on-orbits-equivalence-and-inconsistencies",
      "on-intelligibility"

    center {
      100% * center{width <= 1240px} {
        Right(DownloadButton, LoginButton()).map(& px 5)
      }
      100% * center Image{width <= 400px}(./lib/organizations/orbitmines/logo.png, width: 90%)
      // equivalent to, because .png suggests Image already, no need to do so expliceitely.
      1 * center @./lib/organizations/orbitmines/logo.png{width: 90% & <= 400px}
      1.0 * center
        (xl 4/12 lg 6/12 md 8/12 sm 10/12 xs 12/12) * center "Once a Minecraft server, now the building of a world where engineering, science, education are all an exploratory videogame.".italic
      100% * center + pt 5 (@orbitmines.avatars.map => Link .location{: URL} => .platform.profile_picture).map(& px 2)
      100% * center Image{height == 120px} ./archive/on-orbits-equivalence-and-inconsistencies/images/header.png
      100% * center
        X{width <= 500px}
        X{width <= 500px}
      100% * Author(@fadi, margin.top: 5%)
    }

    center .map(100% * center * .) <- {
      {width <= 1240px} {
        Right .map(& px 5) <- {
          DownloadButton, LoginButton
        }
      }
      Image{width <= 400px}(./lib/organizations/orbitmines/logo.png, width: 90%)
      // equivalent to, because .png suggests Image already, no need to do so expliceitely.
      @./lib/organizations/orbitmines/logo.png{width: 90% & <= 400px}

      // Better controls for this instead of always defining xl/xs, but smooth transition how?
      (xl 4/12 -> xs 12/12) "Once a Minecraft server ..."
      pt 5 .map(& px 2) <- (@orbitmines.avatars.map => .location{: URL}.platform.profile_picture)
      mage{height == 120px} ./archive/on-orbits-equivalence-and-inconsistencies/images/header.png
      {
        X{width <= 500px}
        X{width <= 500px}
      }
      @fadi as Author {margin.top: 5%}
      mt 5 @fadi as Author
      mt 5 { @fadi as Author }
    }
    
    // equiv to this.
    center {}.map(100% * center * .)
  }
}

// div becomes a span
.map(,) <- {
  SomethingThatWouldBeADiv
  SomethingThatWouldBeADiv
}
// span becomes a div with .map(\n)

Author: Player = {

