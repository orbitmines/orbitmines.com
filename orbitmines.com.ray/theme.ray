// A style is a partial shape: what `^name` narrows the styled value to. The web level writes it as CSS,
// the terminal level as cell attributes and colours; neither is spelled here (F-C2, F-D3).
UI.Theme.spacing = 0.125rem
UI.Theme.styles = [
  ("background", fill: "#0a0a0a" as Color, color: "#f6f7f9" as Color, font: Font(family: ["JetBrainsMono", "monospace"], size: 14px, line_height: 1.28581)),
  ("article", font: Font(size: 1.1rem), white_space: WhiteSpace(lines: true, wraps: anywhere)),
  ("anchor", color: "#8abbff" as Color),
  ("muted", color: "#abb3bf" as Color),
  ("disabled", color: "#abb3bf99" as Color),
  ("faded", effects: [Filter(opacity, 0.45), Filter(grayscale, 1)]),
  ("small", font: Font(size: 0.8rem)),
  ("smaller", font: Font(size: 0.7rem)),
  ("smallest", font: Font(size: 0.6rem)),
  ("large", font: Font(size: 1.4rem, line_height: 1.2)),
  ("label", font: Font(size: 0.8rem, tracking: 1px), case: .upper_case, align: start, padding: (pb 3).padding),
  ("marker", color: "#abb3bf" as Color),
  ("h1", font: Font(size: 36px, weight: 600, line_height: 40 / 36)),
  ("h3", font: Font(size: 22px, weight: 600, line_height: 25 / 22)),
  ("h4", font: Font(size: 18px, weight: 600, line_height: 21 / 18)),
  ("h6", font: Font(size: 14px, weight: 600, line_height: 16 / 14)),
  ("underline", stroke: Stroke("#5F6B7C99" as Color, sides: Geometry.bottom)),
  ("button", padding: (py 2.5 &+ px 5).padding, radius: [2px], gap: Vector(7px), font: Font(size: 14px), color: "#ffffff" as Color),
  ("small_button", padding: (px 3.5).padding),
  ("hovered", fill: "#8f99a826" as Color),
  ("pressed", fill: "#8f99a84d" as Color),
  ("icon", color: "#abb3bf" as Color),
  ("minimal", fill: None, stroke: None),
  ("outlined", stroke: Stroke("#ffffff66" as Color)),
  ("circle", radius: [9999px]),
  ("tag", padding: (px 3 &+ py 1).padding, radius: [2px], gap: Vector(4px), fill: "#8f99a826" as Color, font: Font(size: 12px, line_height: 16 / 12)),
  ("tag_hovered", fill: "#8f99a84d" as Color),
  ("primary_tag", fill: "#2d72d233" as Color, color: "#8abbff" as Color),
  ("primary_tag_hovered", fill: "#2d72d24d" as Color, color: "#99c4ff" as Color),
  ("warning_tag", fill: "#c8761933" as Color, color: "#fbb360" as Color),
  ("danger_tag", fill: "#cd424633" as Color, color: "#fa999c" as Color),
  ("block", padding: (pt 6.5 &+ pr 7.5 &+ pb 6 &+ pl 7.5).padding, margin: (my 5).margin, radius: [2px], fill: "#111418" as Color, color: "#f6f7f9" as Color, font: Font(family: ["monospace"], size: 1.1rem, line_height: 1.4), white_space: WhiteSpace.pre, overflow: scroll, width: (xs 1 -> md 8/10)),
  ("code", font: Font(family: ["monospace"])),
  ("nowrap", white_space: WhiteSpace.nowrap),
  ("divider", stroke: Stroke("#ffffff33" as Color, sides: Geometry.bottom), margin: (m 2.5).margin),
  ("link", color: "#5d7eac" as Color),
  ("primary", color: "#4c90f0" as Color),
  ("warning", color: "#EAB832" as Color),
  ("danger", color: "#e76a6e" as Color),
  ("selected", color: "#FFA500" as Color),
  ("mark", fill: "#ffb3474d" as Color, padding: (py 0.5 &+ px 1).padding, radius: [2px]),
  ("sidebar", stroke: Stroke("#6c6783" as Color, sides: Geometry.right)),
  ("overlay", fill: "#00000080" as Color),
  ("popover", fill: "#0a0a0a" as Color, radius: [2px], layer: 20, effects: [Shadow(Vector(), spread: 1px, color: "#1114181a" as Color), Shadow(Vector(0, 2px), blur: 4px, color: "#11141833" as Color), Shadow(Vector(0, 8px), blur: 24px, color: "#11141833" as Color)]),
  ("nav", color: "#ffffff" as Color, font: Font(size: 28px), align: center),
  ("nav_hovered", fill: "#00000066" as Color),
  ("nav_badge", fill: "#00000099" as Color, color: "#ffffff" as Color, padding: (py 1 &+ px 4).padding, radius: [4px], font: Font(size: 0.75rem)),
  ("orange", color: "#FFA500" as Color),
  ("red", color: "#FF5555" as Color),
  ("blue", color: "#5555FF" as Color),
  ("pink", color: "#FF55FF" as Color)
]
UI.Theme.kinds = {
  {link: Geometry.Shape{location}} => link ^anchor
}

DRACULA := theme `Dracula` {
  ^keyword = ^ #BD93F9
  ^variable = ^ #BD93F9
  ^function = ^ #50FA7B
  ^method = ^ #50FA7B
  ^string = ^ #FF79C6
  ^character = ^ #FF79C6
  ^comment = ^ #6272A4
  ^punctuation = ^ #F8F8F2
}
DUOTONE_DARK := theme `Duotone Dark` {
  ^comment = ^ #6C6783
  ^punctuation = ^ #6C6783
  ^operator = ^ #E09142
  ^number = ^ #E09142
  ^property = ^ #9A86FD
  ^function = ^ #9A86FD
  ^method = ^ #9A86FD
  ^string = ^ #FFCC99
  ^keyword = ^ #FFCC99
  ^variable = ^ #FFCC99
}
ONE_DARK := theme `One Dark` {
  ^comment = ^ #5C6370
  ^punctuation = ^ #ABB2BF
  ^class = ^ #D19A66
  ^number = ^ #D19A66
  ^keyword = ^ #C678DD
  ^property = ^ #E06C75
  ^string = ^ #98C379
  ^character = ^ #98C379
  ^variable = ^ #61AFEF
  ^operator = ^ #61AFEF
  ^function = ^ #61AFEF
}
