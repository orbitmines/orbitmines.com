Character &+= {
  formal_citation_name: None
  orcid: None
  handle => .name
}

Organization &+= {
  key => .handle
}

Avatar &+= {
  location: .platform.at(.name)
}

Platform := class: Organization {
  prefix: Node
  suffix: ""

  at (handle: String) => .prefix + (handle + .suffix)
  .@{handle} => Avatar(name: handle, platform: this)
}

@github: Platform = {
  name: "GitHub"
  prefix: @https://github.com/
  profile_picture: @../orbitmines.com/public/organizations/icons/github.svg
}

