      "books": [
        "main",
        "II"
      ],
      "pages": [
        {
          "html": "<p><a class=\"lore-link\" data-ref=\"II\">[II]</a> had taken <a class=\"lore-link\" data-ref=\"IID\">the professor</a>&#39;s course three times now in different\nforms, and never seen the slide that went up that morning.</p>\n<p>It was not on the syllabus. It was, as far as she could tell, not on anyone&#39;s\nsyllabus.</p>",
          "refs": [
            "II",
            "IID"
          ],
          "factIds": [
            "ii-lecture#0#0"
          ]
        },
        {
